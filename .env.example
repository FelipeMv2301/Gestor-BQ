#Credenciales de la base de datos
DB_NAME =
DB_USER =
DB_PASSWORD =
DB_PORT = 5432
DB_HOST =

#WooCommerce
WOO_BASE_URL =
WOO_CONSUMER_KEY =
WOO_CONSUMER_SECRET =

#Parametriza el código interno del ejecutivo web en caso de que por algún motivo cambie
EJECUTIVO_WEB_SAP = 25

#Credenciales para Google OAuth
GOOGLE_CLIENT_ID =
GOOGLE_CLIENT_SECRET =

#Cuenta no-reply para envío de notificaciones
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_BCC=informatica@bioquimica.cl,despachos@bioquimica.cl
EMAIL_PROMO_ACTIVA=TRUE
EMAIL_PICKUP_PROMO_IMG_URL= #Imagen para promos de retiro en tienda / despachos

#Esto filtra el dominio únicamente al de @bioquimica.cl
DOMINIO_PERMITIDO = @bioquimica.cl

#Conexión a Token-SAP-BQ
TOKEN_SAP_BQ_URL =
TOKEN_SAP_BQ_USER =
TOKEN_SAP_BQ_PASS =

#URL de SAP
SAP_URL =

#Version: SQLITE (dev) o cualquier otro valor (Postgres)
DATABASE_VERSION = SQLITE

# Conexión WS Chibra (Alerce)
CHIBRA_BASE_URL=
CHIBRA_USER=
CHIBRA_PASSWORD=
CHIBRA_CLIENTE_REMITENTE = #SCL000278 es producción, SCL000200 es de prueba

#Conexión API MoveUP — el token va como "Authorization: Bearer <token>" en toda llamada
#(integraciones/moveup_client.py::_headers). Sin él, las consultas de estado fallan en runtime.
MOVEUP_BASE_URL=
MOVEUP_ACCESS_TOKEN=

